{
  "name": "geospillet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Et norsk geografispill for flagg, land og hovedsteder.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run test && vite build",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-data.mjs",
    "build:offline": "node scripts/offline-build.mjs",
    "test:offline": "tsc -p tsconfig.offline.json && node --test tests/offline-core.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
